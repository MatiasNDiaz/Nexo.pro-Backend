# Referencia para cargar en Railway. NO se usa como archivo: en producción todo viene del panel del proveedor.
NODE_ENV=production
PORT=3001
API_PREFIX=api
FRONTEND_ORIGINS=https://app.<dominio>
TRUST_PROXY=1
BODY_LIMIT=100kb
# Prohibido en producción: la validación del entorno lo rechaza
SWAGGER_ENABLED=false
LOG_LEVEL=info
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Red privada de Railway. Usuario de runtime sin DDL; el de migraciones solo en el paso de deploy.
DATABASE_URL=postgres://<usuario_runtime>:<password>@<host_privado>:5432/<base>
DATABASE_MIGRATIONS_URL=postgres://<usuario_owner>:<password>@<host_privado>:5432/<base>
DB_SSL=false
DB_POOL_MAX=10
