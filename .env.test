# Valores para Jest (se versiona). Sin secretos reales: son las credenciales del PostgreSQL
# efímero de la CI. En tu máquina, sobrescribilas en .env.test.local (no se versiona).
NODE_ENV=test
PORT=3001
API_PREFIX=api
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY=0
BODY_LIMIT=100kb
SWAGGER_ENABLED=false
LOG_LEVEL=silent
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000
# La base de tests DEBE terminar en _test: los tests borran su esquema completo.
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo_test
DB_SSL=false
DB_POOL_MAX=5
