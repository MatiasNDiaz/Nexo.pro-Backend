# Referencia para cargar en Railway. NO se usa como archivo: en producción todo viene del panel del
# proveedor. Ver docs/env.md y docs/operacion.md. La API no arranca si falta algo obligatorio.
NODE_ENV=production
PORT=3001
API_PREFIX=api
FRONTEND_ORIGINS=https://<dominio>
FRONTEND_URL=https://<dominio>
# Railway pone un proxy delante: obligatorio en producción
TRUST_PROXY=1
BODY_LIMIT=100kb
# Prohibido en producción: la validación del entorno lo rechaza
SWAGGER_ENABLED=false
LOG_LEVEL=info
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Red privada de Railway. Usuario de runtime sin DDL; el de migraciones solo en el paso de deploy.
DATABASE_URL=postgres://<usuario_runtime>:<password>@<host_privado>:5432/<base>
DATABASE_MIGRATIONS_URL=postgres://<usuario_owner>:<password>@<host_privado>:5432/<base>
DB_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# Secretos: al azar y distintos de staging (node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=<64+ caracteres>
CSRF_SECRET=<32+ caracteres>
DATA_ENCRYPTION_KEY=<64 caracteres hex: randomBytes(32)>
DATA_HMAC_KEY=<32+ caracteres>
COOKIE_SECURE=true

# Email (proveedor real pendiente: consola y memoria están prohibidos en producción)
MAIL_PROVIDER=<proveedor>
MAIL_FROM=Nexo PRO <no-reply@<dominio>>

# Archivos (Cloudinary obligatorio en producción)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=<nube>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>
CLOUDINARY_FOLDER=nexo-prod

# Verificación de identidad: manual hasta elegir proveedor (ADR 0003)
IDENTITY_PROVIDER=manual

# Login con Google (ADR 0023)
GOOGLE_PROVIDER=google
GOOGLE_CLIENT_ID=<client id>
GOOGLE_CLIENT_SECRET=<client secret>
GOOGLE_CALLBACK_URL=https://api.<dominio>/api/v1/auth/google/callback

# Pagos (ADR 0026)
PAYMENTS_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=<access token productivo>
MERCADOPAGO_WEBHOOK_SECRET=<clave de webhooks>
API_PUBLIC_URL=https://api.<dominio>

# Antiabuso (etapa 12): apagados hasta cargar las claves
PASSWORD_BREACH_CHECK=true
TURNSTILE_SECRET_KEY=<clave secreta de Turnstile>

# Errores (etapa 12): sin DSN queda apagado
SENTRY_DSN=https://<clave>@<org>.ingest.sentry.io/<proyecto>
