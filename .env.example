# Plantilla con TODAS las variables que usa la API. Sin valores reales.
# Detalle de cada una en docs/env.md. Los secretos de tu máquina van en .env.development.local (no se versiona).

NODE_ENV=development
PORT=3001
API_PREFIX=api
# Orígenes exactos del frontend, separados por coma (sin barra final, sin comodines)
FRONTEND_ORIGINS=http://localhost:3000
# Cantidad de proxies delante de la API (0 en local, 1 en Railway)
TRUST_PROXY=0
BODY_LIMIT=100kb
SWAGGER_ENABLED=true
LOG_LEVEL=info
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Docker Compose (solo desarrollo local)
POSTGRES_HOST_PORT=5433
POSTGRES_USER=nexo
POSTGRES_PASSWORD=
POSTGRES_DB=nexo_dev
