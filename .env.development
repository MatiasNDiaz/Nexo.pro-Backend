# Valores de desarrollo SIN secretos (se versiona). Los secretos van en .env.development.local.
NODE_ENV=development
PORT=3001
API_PREFIX=api
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY=0
BODY_LIMIT=100kb
SWAGGER_ENABLED=true
LOG_LEVEL=info
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
PASSWORD_SELF_RESET_ENABLED=false
# Los emails se imprimen en la consola (solo desarrollo; prohibido en producción)
MAIL_PROVIDER=console
MAX_SERVICE_AREAS=20
# Archivos en disco (carpeta ignorada por git) hasta tener las credenciales de Cloudinary
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.uploads
# Verificación de identidad manual: la decide el admin (ADR 0003)
IDENTITY_PROVIDER=manual
