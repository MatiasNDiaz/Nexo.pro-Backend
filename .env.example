# Plantilla con TODAS las variables que usa la API. Sin valores reales.
# Detalle de cada una en docs/env.md. Los secretos de tu máquina van en .env.development.local
# (y .env.test.local para los tests); ninguno de los dos se versiona.

NODE_ENV=development
PORT=3001
API_PREFIX=api
# Orígenes exactos del frontend, separados por coma (sin barra final, sin comodines)
FRONTEND_ORIGINS=http://localhost:3000
# Cantidad de proxies delante de la API (0 en local, 1 en Railway)
TRUST_PROXY=0
BODY_LIMIT=100kb
SWAGGER_ENABLED=true
LOG_LEVEL=info
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Base de datos. Runtime: usuario con privilegios mínimos. Migraciones: usuario con DDL.
DATABASE_URL=postgres://nexo_app:<password>@localhost:5433/nexo_dev
DATABASE_MIGRATIONS_URL=postgres://nexo:<password>@localhost:5433/nexo_dev
DB_SSL=false
DB_POOL_MAX=10

# Autenticación (docs/auth.md). Generá cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=
# Solo durante una rotación del secreto (opcional)
JWT_ACCESS_SECRET_PREVIOUS=
JWT_ISSUER=nexo-api
JWT_AUDIENCE=nexo-web
ACCESS_TOKEN_TTL_SEC=600
ADMIN_ACCESS_TOKEN_TTL_SEC=300
REFRESH_IDLE_TTL_SEC=1209600
ADMIN_REFRESH_IDLE_TTL_SEC=43200
REFRESH_ABSOLUTE_TTL_SEC=2592000
ADMIN_REFRESH_ABSOLUTE_TTL_SEC=604800
# true en producción (obligatorio): cookies Secure con prefijos __Host-/__Secure-
COOKIE_SECURE=false
CSRF_SECRET=
# 32 bytes en hex (64 caracteres): randomBytes(32).toString('hex')
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1
DATA_HMAC_KEY=
# Apagado por decisión del fundador (ADR 0002)
PASSWORD_SELF_RESET_ENABLED=false
# console (desarrollo) | memory (tests). En producción hace falta un proveedor real.
MAIL_PROVIDER=console
MAIL_FROM=Nexo PRO <no-reply@localhost>
MAX_SERVICE_AREAS=20
# Días restaurables de una cuenta dada de baja antes de anonimizarla (ADR 0016)
ACCOUNT_DELETION_GRACE_DAYS=30

# Archivos (ADR 0018). local (desarrollo y tests: disco) | cloudinary (obligatorio en producción)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raíz en Cloudinary: una por ambiente (nexo-dev, nexo-prod)
CLOUDINARY_FOLDER=nexo-dev

# Verificación de identidad (ADR 0003). manual (el admin decide) | fake (simulado, prohibido en producción)
IDENTITY_PROVIDER=manual
IDENTITY_MAX_ATTEMPTS=3
FAKE_IDENTITY_WEBHOOK_SECRET=

# Login con Google (ADR 0015 y 0023). disabled | google | fake (simulado, prohibido en producción)
GOOGLE_PROVIDER=disabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública del callback de la API, registrada en Google Cloud
GOOGLE_CALLBACK_URL=

# Pagos con Mercado Pago (ADR 0026). disabled | mercadopago | fake (simulado, prohibido en producción)
PAYMENTS_PROVIDER=disabled
# Access token de la cuenta de Mercado Pago (de prueba o productiva)
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de las notificaciones (Tus integraciones > Webhooks): valida la firma x-signature
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública de la API, sin prefijo (el webhook queda en /api/v1/webhooks/payments)
API_PUBLIC_URL=

# Tiempo máximo de una consulta de la app en ms (las migraciones no lo usan)
DB_STATEMENT_TIMEOUT_MS=15000

# Antiabuso (etapa 12): contraseñas filtradas (Have I Been Pwned) y CAPTCHA (Cloudflare Turnstile)
PASSWORD_BREACH_CHECK=false
TURNSTILE_SECRET_KEY=
# Secreto que agrega Cloudflare para confiar en su ciudad aproximada (ADR 0031). Vacío = sin ciudad
CLOUDFLARE_EDGE_SECRET=

# Notificaciones push (ADR 0032): disabled | webpush | fake. Claves con `npm run push:keys`
PUSH_PROVIDER=disabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Errores en Sentry (sin datos personales). Vacío = apagado
SENTRY_DSN=

# Docker Compose (solo desarrollo local; van en el archivo .env)
POSTGRES_HOST_PORT=5433
POSTGRES_USER=nexo
POSTGRES_PASSWORD=
POSTGRES_DB=nexo_dev
# Contraseña del rol de runtime nexo_app (solo letras y números)
POSTGRES_APP_PASSWORD=
